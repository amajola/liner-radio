{
  "name": "liner-radio",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "alchemy dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "alchemy deploy",
    "deploy:dev": "alchemy deploy --stage dev",
    "deploy:prod": "alchemy deploy --stage prod",
    "destroy:dev": "alchemy destroy --stage dev",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "bun run typecheck && bun run test && bun run build",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@tanstack/react-query": "^5.102.8",
    "better-auth": "^1.7.2",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0-rc.112",
    "lucide-react": "^1.31.0",
    "motion": "^13.2.0",
    "music-metadata": "11.15.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@effect/platform-bun": "^4.0.0-rc.112",
    "@effect/platform-node": "^4.0.0-rc.112",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "alchemy": "2.0.0-beta.76",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
