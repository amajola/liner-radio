{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "worker/**/*.ts", "db/**/*.ts", "lib/**/*.ts", "alchemy.run.ts", "vite.config.ts", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist", "app", "components", "hooks", "build", "scripts"]
}
